FROM python:3.11-slim
WORKDIR /app
COPY requirements-monitoring.txt .
RUN pip install --no-cache-dir -r requirements-monitoring.txt
COPY application.py .
COPY monitoring/ monitoring/
COPY scripts/ scripts/
COPY templates/ templates/
COPY static/ static/
COPY artifacts/models/ artifacts/models/
COPY artifacts/processed/ artifacts/processed/
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "application:app"]
